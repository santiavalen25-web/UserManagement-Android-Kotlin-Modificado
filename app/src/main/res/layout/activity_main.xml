<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- BARRA SUPERIOR CON ÍCONO DE SALIDA EN LA ESQUINA SUPERIOR DERECHA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnLogoutIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar sesión"
            android:src="@android:drawable/ic_lock_power_off"
            app:tint="#D32F2F" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSaludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Bienvenido"
        android:textColor="#4A424D"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:text="¿Qué deseas hacer?"
        android:textColor="#666666"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnParImpar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ejercicio Par o Impar" />

</LinearLayout>